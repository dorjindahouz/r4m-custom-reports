# Copy to .env (same folder as this file) and fill in. Never commit .env.
# Read by overspeed/env.py; an environment variable with the same name wins over the file.
# Hostnames of the VMs contain spaces, so the scripts use the *_IP_ADDRESS keys.

# C4M database VM (ControlSenseDB). The fetch scripts log in over SSH and run
# `sudo -S -u postgres psql` (SELECT only). The OS login is not a Postgres role.
C4M_DB_IP_ADDRESS='192.0.2.15'
C4M_DB_USERNAME=''
C4M_DB_PASSWORD=''
# Optional: a direct read-only Postgres role instead of SSH + sudo
# C4M_DB_MODE='ssh'            # 'ssh' skips the direct-connection attempts
# C4M_DB_USER=''
# C4M_DB_PASSWORD_PG=''
# C4M_DB_NAME='ControlSenseDB'
# C4M_DB_PORT='5432'

# R4M app VM (hosts the pages, the nightly jobs and the publish/refresh service).
# Used by the install / deploy scripts (SSH + SFTP).
R4M_APP_IP_ADDRESS='192.0.2.18'
R4M_APP_USERNAME=''
R4M_APP_PASSWORD=''
